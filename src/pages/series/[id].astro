---
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import { getSeries } from "@/utils/getSeries";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

export async function getStaticPaths() {
  return (await getSeries()).map(group => ({
    params: { id: group.definition.id },
    props: { group },
  }));
}
type Props = { group: Awaited<ReturnType<typeof getSeries>>[number] };
const {
  group: { definition, posts },
} = Astro.props;
const { Content } = await render(definition);
---

<Layout
  title={`${definition.data.title} | ${config.site.title}`}
  description={definition.data.description}
>
  <Header />
  <div class="app-layout my-6">
    <a
      class="text-accent hover:underline"
      href={getRelativeLocaleUrl(config.site.lang, "series")}>← 모든 시리즈</a
    >
  </div>
  <Main
    pageTitle={definition.data.title}
    pageDesc={definition.data.description}
  >
    <div class="app-prose mb-8"><Content /></div>
    <h2 class="text-xl font-semibold">
      연재 목차 <span class="text-muted-foreground text-base font-normal"
        >· {posts.length}편</span
      >
    </h2>
    <ol class="my-6 space-y-5" aria-label="연재 목차">
      {
        posts.map(post => (
          <li class="border-b pb-5" value={post.data.seriesOrder}>
            <a
              href={getPostUrl(post.id, post.filePath)}
              class="text-accent text-lg font-medium hover:underline"
            >
              {post.data.seriesOrder}회. {post.data.title}
            </a>
            <p class="mt-1">{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </Main>
  <Footer />
</Layout>
